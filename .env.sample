# このファイルを .env にコピーして、実際の値を書き込んでください。
# .env は .gitignore 済みです。コミットしないこと。

#--------------------------------------------------------------
# 通知先のオン/オフ（1=送る / 0=送らない）
# 両方 1 なら Discord とメールの両方に届きます。
#--------------------------------------------------------------
NOTIFY_DISCORD=1
NOTIFY_EMAIL=0

#--------------------------------------------------------------
# Discord 通知（NOTIFY_DISCORD=1 のとき使用）
#--------------------------------------------------------------
# Webhook URL。URLを知る者は誰でも投稿できるため厳重に扱う。
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/【ID】/【トークン】

#--------------------------------------------------------------
# メール通知（NOTIFY_EMAIL=1 のとき使用）
#--------------------------------------------------------------
# SMTPサーバ。ポート465は smtps:// 、ポート587は smtp:// + MAIL_STARTTLS=1
MAIL_SMTP_URL=smtps://smtp.gmail.com:465
MAIL_STARTTLS=0

# 差出人／宛先。MAIL_TO はカンマ区切りで複数指定できる
MAIL_FROM=voip-notify@example.com
MAIL_TO=you@example.com
MAIL_FROM_NAME=Asterisk 留守番電話

# SMTP認証（不要なサーバなら空のままでよい）
# ※Gmailの場合、ログインパスワードではなく「アプリパスワード」を使う
MAIL_USER=voip-notify@example.com
MAIL_PASS=【アプリパスワード】

# 音声を添付するか（0で本文のみ）と、添付する上限バイト数
MAIL_ATTACH=1
MAIL_ATTACH_MAX=20000000

# --- TLS証明書（curl終了コード60が出るときだけ設定する） ---
# 社内CA/自己署名の証明書を使うサーバ向け。CA証明書(PEM)をマウントして指定する。
# docker-compose.yml に次の1行を足しておくこと:
#   - ./certs:/etc/asterisk/certs:ro
#MAIL_CAINFO=/etc/asterisk/certs/ca.pem
#
# 証明書に書かれた名前がDNSに載っていない場合の逃げ道。
# ホスト:ポート:IP を指定すると、その名前をそのIPへ直接つなぐ。
# 証明書は正しい名前で検証されるので MAIL_TLS_INSECURE より安全。
# ※MAIL_SMTP_URL のホスト名も同じ名前にすること。
#MAIL_RESOLVE=ms01.example.jp:587:203.0.113.10

# 1 にすると証明書の検証を省略する（通信は暗号化されるが相手の真正性は確認しない）。
# LAN内の自社サーバ限定の応急処置とすること。
MAIL_TLS_INSECURE=0

#--------------------------------------------------------------
# 通知の共通しきい値
#--------------------------------------------------------------
# これより短い録音は通知しない（秒で指定）。
# ビープ直後に切られたものやノイズだけの録音を弾くため。
# ※通知を止めるだけで、録音ファイル自体は ./recordings に残る。
#   短い伝言も拾いたいなら 1〜2、通知を減らしたいなら 5 くらいにする。
NOTIFY_MIN_SEC=3

#--------------------------------------------------------------
# 録音ファイルの保存
#--------------------------------------------------------------
# 録音の保存日数。これより古い .wav は毎日自動削除される。
RETENTION_DAYS=30

# 1 にすると削除せずログに一覧を出すだけ（動作確認用）。
CLEANUP_DRY_RUN=0

# 通知スクリプトのログ出力先（既定は ./recordings/notify.log）
#NOTIFY_LOG=/var/spool/asterisk/recordings/notify.log

# 1 にすると curl のSMTP通信内容までログに出す（メール不達の調査用）
MAIL_DEBUG=0
